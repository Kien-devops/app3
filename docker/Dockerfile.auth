FROM node:22-alpine AS runtime
WORKDIR /app
COPY services/auth/package.json services/auth/package-lock.json ./
RUN npm ci --omit=dev --silent && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /root/.npm
COPY services/auth/ ./
EXPOSE 8080
USER node
CMD ["node", "server.js"]

